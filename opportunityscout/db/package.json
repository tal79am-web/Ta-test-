{
  "name": "@opportunityscout/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/client.js",
  "types": "src/client.ts",
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "tsx src/migrations/seed.ts",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
