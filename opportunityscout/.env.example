# =============================================================================
# OpportunityScout Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# CORE APPLICATION
# =============================================================================

# Application environment: development | production | test
NODE_ENV=development

# Secret API key for protected admin endpoints (generate with: openssl rand -hex 32)
API_KEY=your-secret-api-key-here

# URL of the frontend application (used for CORS)
FRONTEND_URL=http://localhost:3000

# Backend server port
BACKEND_PORT=3001

# =============================================================================
# DATABASE (PostgreSQL 15)
# =============================================================================

# Full connection URL (used by Prisma)
DATABASE_URL=postgresql://scout:scoutpassword@localhost:5432/opportunityscout

# Individual connection parameters (used by docker-compose)
POSTGRES_USER=scout
POSTGRES_PASSWORD=scoutpassword
POSTGRES_DB=opportunityscout
POSTGRES_PORT=5432

# =============================================================================
# CACHE / QUEUE (Redis 7)
# =============================================================================

# Full Redis connection URL (used by BullMQ)
REDIS_URL=redis://:redispassword@localhost:6379

# Individual Redis parameters (used by docker-compose)
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# =============================================================================
# AI / LLM
# =============================================================================

# Anthropic API key - get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model to use (do not change unless you know what you're doing)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Max tokens for opportunity extraction responses
ANTHROPIC_MAX_TOKENS=4096

# Temperature for AI responses (0.0 - 1.0)
ANTHROPIC_TEMPERATURE=0.3

# =============================================================================
# EMAIL (Resend)
# =============================================================================

# Resend API key - get from https://resend.com
RESEND_API_KEY=re_...

# Email address to send daily summaries to
ALERT_EMAIL=you@yourdomain.com

# From address for outgoing emails (must be verified in Resend)
EMAIL_FROM=OpportunityScout <noreply@yourdomain.com>

# =============================================================================
# SCHEDULER
# =============================================================================

# Cron schedule for the daily crawl (default: 5:00 AM UTC)
CRAWL_SCHEDULE=0 5 * * *

# Maximum concurrent crawlers running at once
MAX_CONCURRENT_CRAWLERS=3

# Request delay between pages in milliseconds
CRAWLER_DELAY_MS=1500

# =============================================================================
# REDDIT API
# Get credentials at https://www.reddit.com/prefs/apps
# =============================================================================

REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=OpportunityScout/1.0 (by /u/yourusername)

# Subreddits to crawl (comma-separated)
REDDIT_SUBREDDITS=entrepreneur,startups,SaaS,smallbusiness,marketing,webdev,programming,indiehackers

# Maximum posts per subreddit per crawl
REDDIT_MAX_POSTS=100

# =============================================================================
# GITHUB API
# Get token at https://github.com/settings/tokens (read:public_repo scope)
# =============================================================================

GITHUB_TOKEN=ghp_...

# =============================================================================
# STACK OVERFLOW API
# Get key at https://stackapps.com/apps/oauth/register
# =============================================================================

STACKOVERFLOW_KEY=your-stackoverflow-key

# =============================================================================
# PRODUCT HUNT API
# Get token at https://www.producthunt.com/v2/oauth/applications
# =============================================================================

PRODUCTHUNT_TOKEN=your-producthunt-token

# =============================================================================
# SCORING WEIGHTS
# These control how the composite opportunity score is calculated.
# All weights should sum to 1.0
# =============================================================================

# Weight for community engagement volume (upvotes, comments, views)
SCORE_WEIGHT_VOLUME=0.30

# Weight for estimated market/revenue size indicators
SCORE_WEIGHT_MARKET_SIZE=0.30

# Weight for strategic/technological significance
SCORE_WEIGHT_SIGNIFICANCE=0.25

# Weight for urgency and timing signals
SCORE_WEIGHT_URGENCY=0.15

# Minimum composite score to store an opportunity (0-100)
MIN_OPPORTUNITY_SCORE=40

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable individual crawlers
ENABLE_REDDIT=true
ENABLE_HACKERNEWS=true
ENABLE_PRODUCTHUNT=true
ENABLE_GITHUB=true
ENABLE_STACKOVERFLOW=true
ENABLE_DEVTO=true
ENABLE_G2REVIEWS=true
ENABLE_INDIEHACKERS=true

# Enable email sending
ENABLE_EMAIL=false

# Enable AI deduplication clustering
ENABLE_CLUSTERING=true

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Pretty print logs in development
LOG_PRETTY=true
