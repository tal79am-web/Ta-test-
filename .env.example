# ─── SAP OData connection ─────────────────────────────────────────────────────
# Base URL for SAP OData services, e.g. https://my-sap-host/sap/opu/odata/sap
SAP_BASE_URL=https://your-sap-host/sap/opu/odata/sap
SAP_USERNAME=your-sap-user
SAP_PASSWORD=your-sap-password
SAP_CLIENT=100           # SAP client/mandant (optional)
SAP_LANGUAGE=EN          # Logon language (optional, default EN)

# ─── Generic / Custom ERP REST connection ─────────────────────────────────────
# Base URL for the ERP REST API
ERP_BASE_URL=https://your-erp-host/api

# Auth type: none | basic | bearer | api_key
ERP_AUTH_TYPE=bearer

# Basic auth (ERP_AUTH_TYPE=basic)
ERP_USERNAME=
ERP_PASSWORD=

# Bearer token (ERP_AUTH_TYPE=bearer)
ERP_BEARER_TOKEN=your-token-here

# API Key (ERP_AUTH_TYPE=api_key)
ERP_API_KEY=
ERP_API_KEY_HEADER=X-API-Key   # Header name for API key (default: X-API-Key)
